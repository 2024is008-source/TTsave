{
  "name": "tiksavemp4",
  "version": "0.1.0",
  "private": true,
  "description": "TikSaveMp4 web application foundation",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/server.ts",
    "css:build": "sass --no-source-map src/styles/app.scss public/assets/app.css",
    "css:watch": "sass --watch --no-source-map src/styles/app.scss public/assets/app.css",
    "images:build": "node scripts/build-images.mjs",
    "frontend:build": "esbuild src/frontend/downloader.ts --bundle --minify --format=esm --platform=browser --target=es2023 --outfile=public/assets/js/downloader.js",
    "frontend:watch": "npm run frontend:build -- --watch",
    "build": "npm run images:build && npm run css:build && npm run frontend:build && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/e2e/** --exclude tests/browser/**",
    "test:watch": "vitest --exclude tests/e2e/** --exclude tests/browser/**",
    "test:e2e": "vitest run tests/e2e",
    "test:ui": "playwright test",
    "tools:check": "tsx --env-file-if-exists=.env src/check-tools.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.12.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.63.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.3"
  }
}
