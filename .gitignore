# Official publisher configuration; examples stay available
/config/monetag/private/

# Generated browser evidence; curated documentation images remain eligible
/docs/screenshots/browser-*/
/docs/screenshots/advertising/

# Local audit dumps and machine-specific inventories; maintained reports stay tracked.
/docs/blocker-fixes/
/docs/cleanup/
/docs/final-audit/
/docs/production-blockers/
/docs/migration/*.json
/docs/IMAGE_LOADING_BEFORE.json
/docs/IMAGE_OPTIMIZATION_BEFORE.json

# Logs, temporary files and local editor state
*.log
*.tmp
*.bak
*.pid
*.pid.lock
*~
.DS_Store
Thumbs.db
.vs/
.idea/
.history/
**/.localhistory/
