# Private environment files (the documented example remains tracked)
*.env
.env.*
!.env.example

# Persistent operational data, databases and private keys
/.data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
