<svg
  class="icon"
  aria-hidden="true"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <% if (name === 'link') { %>
  <path
    d="m10 13 4-4m-6 6-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 0 1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0"
  />
  <% } else if (name === 'arrow') { %>
  <path d="M5 12h14m-6-6 6 6-6 6" />
  <% } else if (name === 'moon') { %>
  <path d="M20 14A8 8 0 0 1 10 4a8 8 0 1 0 10 10Z" />
  <% } else if (name === 'shield') { %>
  <path d="m12 3 8 3v6c0 4-4 7-8 9-4-2-8-5-8-9V6Z" />
  <path d="m8 12 3 3 5-6" />
  <% } else if (name === 'eye') { %>
  <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z" />
  <circle cx="12" cy="12" r="3" />
  <% } else if (name === 'device') { %>
  <rect x="7" y="2" width="10" height="20" rx="3" />
  <path d="M11 18h2" />
  <% } else if (name === 'menu') { %>
  <path d="M4 7h16M4 12h16M4 17h16" />
  <% } else { %>
  <path d="m5 12 4 4L19 6" />
  <% } %>
</svg>
