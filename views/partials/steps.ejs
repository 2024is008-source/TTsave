<section class="steps-section section" id="how-it-works" aria-labelledby="steps-title">
  <div class="container">
    <div class="section-heading">
      <span class="showcase-label">3 simple steps</span>
      <h2 id="steps-title">
        How to download <span class="gradient-text">TikTok videos</span>
      </h2>
      <p>The simplest path from a public link to your device.</p>
    </div>
    <ol class="step-grid">
      <% steps.forEach((step, index) => { %>
      <li class="step-card glass-card">
        <div class="step-header">
          <span class="step-number" aria-hidden="true"><%= index + 1 %></span>
          <span class="step-icon" aria-hidden="true"
            ><%- include('icon', { name: ['link', 'clipboard', 'download'][index] })
            %></span
          >
        </div>
        <div class="step-copy">
          <h3><%= step.title %></h3>
          <p><%= step.description %></p>
        </div>
      </li>
      <% }) %>
    </ol>
  </div>
</section>
