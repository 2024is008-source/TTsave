<section class="steps-section section" id="how-it-works" aria-labelledby="steps-title">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">From feed to favorite</span>
      <h2 id="steps-title">
        Three steps.<br class="mobile-break" />
        A familiar rhythm.
      </h2>
      <p>The simplest path from a public link to your device.</p>
    </div>
    <ol class="step-grid">
      <% steps.forEach((step, index) => { %>
      <li class="step-card glass-card">
        <div class="step-header">
          <span class="step-number" aria-hidden="true">0<%= index + 1 %></span>
          <%- include('picture', { imageClass: 'step-art', imageName: step.image,
          imageWidth: 800, imageHeight: 600, smallWidth: 400, imageSizes: stepImageSizes,
          imageAlt: '', imageLoading: 'lazy' }) %>
        </div>
        <h3><%= step.title %></h3>
        <p><%= step.description %></p>
      </li>
      <% }) %>
    </ol>
  </div>
</section>
