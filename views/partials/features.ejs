<section class="section container" id="features" aria-labelledby="features-title">
  <div class="section-heading">
    <span class="showcase-label">Why choose TTSave</span>
    <h2 id="features-title">
      Thoughtful features. <span class="gradient-text">Effortlessly simple.</span>
    </h2>
    <p>A clear way to save public TikTok videos, in the quality the source provides.</p>
  </div>
  <div class="feature-grid">
    <% features.forEach((feature) => { %>
    <article class="glass-card feature-card">
      <div class="icon-well <%= feature.color %>">
        <%- include('icon', { name: feature.icon }) %>
      </div>
      <h3><%= feature.title %></h3>
      <p><%= feature.description %></p>
    </article>
    <% }) %>
  </div>
</section>
