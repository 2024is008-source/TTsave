<section class="section container" id="features" aria-labelledby="features-title">
  <div class="section-heading">
    <span class="showcase-label">Why choose TikSaveMp4</span>
    <h2 id="features-title">
      Convert TikTok Videos <span class="gradient-text">to MP4 or MP3</span>
    </h2>
    <p>
      A TikTok to MP4 converter for supported public videos, with MP3 audio when
      available.
    </p>
  </div>
  <div class="feature-grid">
    <% features.forEach((feature) => { %>
    <article class="glass-card feature-card">
      <div class="icon-well <%= feature.color %>">
        <%- include('icon', { name: feature.icon }) %>
      </div>
      <h3><%= feature.title %></h3>
      <p><%= feature.description %></p>
    </article>
    <% }) %>
  </div>
</section>
