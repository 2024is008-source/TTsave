<section
  class="hero home-tool"
  id="hero"
  aria-labelledby="hero-title"
  data-downloader-state="idle"
>
  <div class="home-intro container">
    <h1 id="hero-title">
      Download TikTok<br />
      Videos &amp; Photos
    </h1>
    <p class="hero-description">
      Save public TikTok videos and photo slideshows with a simple link.
    </p>
  </div>
  <div class="home-tool-content">
    <div class="home-media-tabs" role="tablist" aria-label="TikTok media type">
      <button
        id="tool-photo"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="downloader-panel"
        data-media-tool="photo"
      >
        <%- include('icon', {name: 'image'}) %> Photo
      </button>
      <button
        id="tool-video"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="downloader-panel"
        tabindex="-1"
        data-media-tool="video"
      >
        <%- include('icon', {name: 'video'}) %> Video
      </button>
    </div>
    <div
      class="home-download-panel"
      id="downloader-panel"
      role="tabpanel"
      aria-labelledby="tool-photo"
    >
      <h2 id="panel-tool-title">Download TikTok Photos &amp; Slideshows</h2>
      <p id="panel-tool-subtitle">
        Paste a public TikTok post link to save individual images or a selected slideshow.
      </p>
      <%- include('downloader') %>
      <div class="result-workspace" aria-label="Media download workspace">
        <div class="result-workspace-inner">
          <div class="result-preview-column" hidden><%- include('phone-preview') %></div>
          <%- include('result-card') %>
        </div>
      </div>
    </div>
  </div>
</section>
