<picture class="<%= imageClass %>">
  <source
    type="image/webp"
    media="<%= typeof imageMedia !== 'undefined' ? imageMedia : '(min-width: 0px)' %>"
    srcset="<%= imageName === 'hero-video-poster' ? '/assets/images/hero-video-poster-320.webp 320w, ' : '' %>/assets/images/<%= imageName %>-<%= smallWidth %>.webp <%= smallWidth %>w, /assets/images/<%= imageName %>.webp <%= imageWidth %>w"
    sizes="<%= imageSizes %>"
  />
  <img
    src="<%= typeof imageMedia !== 'undefined' ? '/assets/images/transparent.webp' : '/assets/images/' + imageName + '.webp' %>"
    width="<%= imageWidth %>"
    height="<%= imageHeight %>"
    alt="<%= imageAlt %>"
    loading="<%= imageLoading %>"
    decoding="async"
    fetchpriority="<%= typeof imagePriority !== 'undefined' ? imagePriority : 'auto' %>"
  />
</picture>
