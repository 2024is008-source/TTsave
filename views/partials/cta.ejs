<section class="container cta-section" aria-labelledby="cta-title">
  <div class="cta-panel glass-card">
    <div class="cta-decoration" aria-hidden="true">
      <div class="cta-orb cta-orb--pink"></div>
      <div class="cta-orb cta-orb--blue"></div>
    </div>
    <div class="cta-copy">
      <h2 id="cta-title">Use Downloaded Content Responsibly</h2>
      <p>
        Save and reuse content only with permission. Downloads do not grant ownership or
        commercial-use rights. Review <a href="/responsible-use">Responsible Use</a> and
        <a href="/copyright">Copyright and DMCA guidance</a> before downloading.
      </p>
    </div>
    <a class="primary-button cta-button" href="#downloader" id="cta-start-btn"
      ><%- include('icon', { name: 'download' }) %> Start downloading</a
    >
  </div>
</section>
