<section class="section container faq-section" id="faq" aria-labelledby="faq-title">
  <div class="faq-intro">
    <span class="showcase-label">Still have questions?</span>
    <h2 id="faq-title">
      TikTok to MP4 Downloader <span class="gradient-text">FAQ</span>
    </h2>
    <p>A little clarity before your next download.</p>
  </div>
  <div class="faq-list glass-card">
    <% faqs.forEach((faq, i) => { %>
    <details class="faq-item" id="faq-item-<%= i %>">
      <summary aria-expanded="false">
        <%= faq.question %><span class="faq-plus" aria-hidden="true">+</span>
      </summary>
      <p><%= faq.answer %></p>
    </details>
    <% }) %>
  </div>
</section>
