<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Paste a public TikTok video link, review available quality, and download the original available MP4 source."
    />
    <title><%= title %></title>
    <meta property="og:title" content="<%= title %>" />
    <meta
      property="og:description"
      content="Online TikTok video downloader for publicly accessible videos."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/images/og-image.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TTSave — Online TikTok Video Downloader" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/app.css" />
    <script type="module" src="/assets/js/app.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <%- include('partials/header') %>
    <main id="main">
      <%- include('partials/hero') %>
      <div class="landing-showcase">
        <div class="showcase-decoration" aria-hidden="true">
          <%- include('partials/picture', { imageClass: 'showcase-art showcase-art--left',
          imageName: 'showcase-left', imageWidth: 800, imageHeight: 1200, smallWidth: 400,
          imageSizes: '280px', imageAlt: '', imageLoading: 'lazy' }) %> <%-
          include('partials/picture', { imageClass: 'showcase-art showcase-art--right',
          imageName: 'showcase-right', imageWidth: 800, imageHeight: 1200, smallWidth:
          400, imageSizes: '280px', imageAlt: '', imageLoading: 'lazy' }) %>
        </div>
        <%- include('partials/features') %> <%- include('partials/steps') %> <%-
        include('partials/moments') %> <%- include('partials/faq') %> <%-
        include('partials/cta') %>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
