NODE_ENV=development
PUBLIC_BASE_URL=https://tiksavemp4.online
# Optional. Remove or leave blank to disable Analytics. Disable Enhanced Measurement
# in this GA4 web stream before enabling; see docs/ANALYTICS.md.
GA_MEASUREMENT_ID=G-XP63QEZK1R
# LEGAL_CONTACT_EMAIL takes precedence over PUBLIC_CONTACT_EMAIL.
PUBLIC_CONTACT_EMAIL=tiksavemp4@gmail.com
LEGAL_CONTACT_EMAIL=tiksavemp4@gmail.com
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
# Private dashboard remains inaccessible until credentials are configured.
ADMIN_ENABLED=false
# Choose a username and generate the hash in a private terminal: npm run admin:password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8
# Approved executable names on PATH, or local absolute executable paths.
# YTDLP_PATH remains a supported legacy alias; do not set conflicting values.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PREVIEW_MAX_BYTES=3145728
PREVIEW_TIMEOUT_MS=8000
ANALYSIS_TIMEOUT_MS=30000
ANALYSIS_MAX_OUTPUT_BYTES=2097152
ANALYSIS_MAX_CONCURRENT=2
DOWNLOAD_MAX_CONCURRENT=2
APPLICATION_MAX_CONCURRENT=4
DOWNLOAD_TIMEOUT_MS=120000
MAX_VIDEO_DURATION_SECONDS=600
DOWNLOAD_MAX_BYTES=104857600
JOB_TTL_MS=600000
FILE_ACCESS_TTL_MS=60000
JOB_SWEEP_INTERVAL_MS=30000
# DOWNLOAD_TEMP_ROOT may be set to a local absolute directory owned by the server.

# Optional Analytics: consent is required before Google loads.
GA4_REQUIRE_CONSENT=true
# Private local download counts, independent of optional browser Analytics.
OPERATIONS_ENABLED=false
# OPERATIONS_SECRET is optional; normally retain the generated private operations.key.
# Never rotate an existing secret or key as part of a code cleanup.
# Defaults to .data/operations outside public. Use a private absolute path on VPS.
# OPERATIONS_DATA_DIR=/var/lib/tiksavemp4/operations
OPERATIONS_RETENTION_DAYS=30
# Optional readonly Google Data API reporting from analytics:report.
# GA4_PROPERTY_ID=123456789
# GA4_SERVICE_ACCOUNT_FILE=/etc/tiksavemp4/ga4-reader.json
# Leave disabled unless a trusted reverse proxy overwrites X-TikSave-Country.
TRUST_COUNTRY_HEADER=false

# Optional Monetag advertising. No publisher IDs or ad tags ship with the app.
# All switches are false by default; see docs/ADVERTISING.md.
ADVERTISING_ENABLED=false
MONETAG_IPP_ENABLED=false
MONETAG_VIGNETTE_ENABLED=false
MONETAG_MOBILE_ENABLED=false
# Absolute private paths to reviewed JSON manifests; leave blank until supplied.
MONETAG_IPP_TAG_FILE=
MONETAG_VIGNETTE_TAG_FILE=
