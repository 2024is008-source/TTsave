NODE_ENV=development
PUBLIC_BASE_URL=https://tiksavemp4.online
# Set a monitored public inbox before launch; do not invent an address.
# PUBLIC_CONTACT_EMAIL=
# LEGAL_CONTACT_EMAIL= (a monitored legal inbox; takes precedence over PUBLIC_CONTACT_EMAIL)
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
# Approved executable names on PATH, or local absolute executable paths.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PREVIEW_MAX_BYTES=3145728
PREVIEW_TIMEOUT_MS=8000
ANALYSIS_TIMEOUT_MS=30000
ANALYSIS_MAX_OUTPUT_BYTES=2097152
ANALYSIS_MAX_CONCURRENT=2
DOWNLOAD_MAX_CONCURRENT=2
APPLICATION_MAX_CONCURRENT=4
DOWNLOAD_TIMEOUT_MS=120000
MAX_VIDEO_DURATION_SECONDS=600
DOWNLOAD_MAX_BYTES=104857600
JOB_TTL_MS=600000
FILE_ACCESS_TTL_MS=60000
JOB_SWEEP_INTERVAL_MS=30000
# DOWNLOAD_TEMP_ROOT may be set to a local absolute directory owned by the server.
